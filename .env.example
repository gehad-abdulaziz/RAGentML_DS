# Copy this file to .env and fill in your values. NEVER commit .env or API keys.

# --- LLM ---
# One of: openai | anthropic | google | ollama (must match an installed langchain-* package)
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-model-name-here

# --- Neo4j (matches docker-compose.yml defaults) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please

# --- ChromaDB ---
CHROMA_PATH=chroma_db